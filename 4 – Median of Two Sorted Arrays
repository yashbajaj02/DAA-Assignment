class Solution {
    public double findMedianSortedArrays(int[] a, int[] b) {
        if (a.length > b.length) {
            return findMedianSortedArrays(b, a);
        }
        
        int m = a.length, n = b.length;
        int low = 0, high = m;
        
        while (low <= high) {
            int i = (low + high) / 2;
            int j = (m + n + 1) / 2 - i;
            
            double maxL1 = (i == 0) ? Long.MIN_VALUE : a[i - 1];
            double minR1 = (i == m) ? Long.MAX_VALUE : a[i];
            double maxL2 = (j == 0) ? Long.MIN_VALUE : b[j - 1];
            double minR2 = (j == n) ? Long.MAX_VALUE : b[j];
            
            if (maxL1 <= minR2 && maxL2 <= minR1) {
                if ((m + n) % 2 != 0) {
                    return Math.max(maxL1, maxL2);
                }
                return (Math.max(maxL1, maxL2) + Math.min(minR1, minR2)) / 2.0;
            }
            
            if (maxL1 > minR2) {
                high = i - 1;
            } else {
                low = i + 1;
            }
        }
        return 0.0;
    }
}
