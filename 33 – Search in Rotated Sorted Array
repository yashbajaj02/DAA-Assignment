class Solution:
    def search(self, nums: list[int], target: int) -> int:
        left, right = 0, len(nums) - 1
        
        while left <= right:
            mid = left + (right - left) // 2
            
            if nums[mid] == target:
                return mid
            
            # Check if the left half is strictly sorted
            if nums[left] <= nums[mid]:
                # If target is in the range of the sorted left half, search there
                if nums[left] <= target < nums[mid]:
                    right = mid - 1
                # Otherwise, it must be in the right half
                else:
                    left = mid + 1
                    
            # Otherwise, the right half must be strictly sorted
            else:
                # If target is in the range of the sorted right half, search there
                if nums[mid] < target <= nums[right]:
                    left = mid + 1
                # Otherwise, it must be in the left half
                else:
                    right = mid - 1
                    
        return -1
